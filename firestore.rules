rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // პროდუქტების კოლექცია (Products collection)
    // წაკითხვა ყველასთვის ღიაა (სტუმრებისთვისაც).
    // დამატება, რედაქტირება და წაშლა მხოლოდ ადმინისტრატორს შეუძლია (Admin Dashboard).
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // მაღაზიის პარამეტრები და სექციები (Settings & Home customization)
    match /aurelia/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ბლოგის სტატიები (Blog articles)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // შემოსული მოთხოვნები (Inquiries)
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
