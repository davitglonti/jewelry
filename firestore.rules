rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. მთავარი ადმინისტრატორი (Super Admin / სისტემის მფლობელი)
    function isSuperAdmin() {
      return request.auth != null && 
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'datiglonti@gmail.com';
    }

    // ადმინისტრატორის ჩანაწერის წამოღება
    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data;
    }

    // ამოწმებს, აქვს თუ არა მომხმარებელს აქტიური როლი ('admin' ან 'moderator')
    function hasActiveRole(roleName) {
      return request.auth != null &&
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
             getAdminDoc().isActive != false &&
             getAdminDoc().role == roleName;
    }

    // სრული ადმინისტრატორი (Super Admin ან role == 'admin')
    function isFullAdmin() {
      return isSuperAdmin() || hasActiveRole('admin');
    }

    // მოდერატორი (role == 'moderator')
    function isModerator() {
      return hasActiveRole('moderator');
    }

    // კონტენტის მართვა (პროდუქცია და ბლოგი): შეუძლია როგორც სრულ ადმინს, ისე მოდერატორს!
    function canManageContent() {
      return isFullAdmin() || isModerator();
    }

    // ==========================================
    // ადმინისტრატორებისა და მოდერატორების მართვა (/admins)
    // ==========================================
    match /admins/{adminEmail} {
      // get: საკუთარი ჩანაწერის ნახვა (როლის ან mustChangePassword-ის შესამოწმებლად), ან სრულ ადმინს
      allow get: if request.auth != null && (
        isFullAdmin() || 
        isModerator() ||
        (request.auth.token.email != null && request.auth.token.email.lower() == adminEmail.lower())
      );
      // update: საკუთარ ჩანაწერზე სტატუსის (status, joinedAt) ან mustChangePassword-ის განახლება, ან Super Admin-ს
      allow update: if isSuperAdmin() || (
        request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == adminEmail.lower() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt', 'status', 'hasJoined', 'joinedAt', 'lastLoginAt'])
      );
      // list: სრული სიის ნახვა შეუძლია მხოლოდ სრულ ადმინს
      allow list: if isFullAdmin();
      // create / delete: მხოლოდ მთავარ ადმინისტრატორს (Super Admin)
      allow create, delete: if isSuperAdmin();
    }

    // ==========================================
    // პროდუქტების კოლექცია (/products)
    // ==========================================
    // - წაკითხვა: ყველასთვის ღიაა (სტუმრებისთვისაც)
    // - დამატება, რედაქტირება, წაშლა: სრული ადმინისტრატორი ან მოდერატორი!
    match /products/{productId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    // ==========================================
    // ბლოგის სტატიები (/articles)
    // ==========================================
    // - წაკითხვა: ყველასთვის ღიაა
    // - შექმნა, რედაქტირება, წაშლა: სრული ადმინისტრატორი ან მოდერატორი!
    match /articles/{articleId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    // ==========================================
    // მაღაზიის პარამეტრები (/aurelia/**)
    // ==========================================
    // - წაკითხვა: ყველასთვის ღიაა
    // - შეცვლა: მხოლოდ სრულ ადმინისტრატორს! (მოდერატორს ეკრძალება)
    match /aurelia/{document=**} {
      allow read: if true;
      allow write: if isFullAdmin();
    }

    // ==========================================
    // შემოსული მოთხოვნები (/inquiries)
    // ==========================================
    // - შექმნა: ნებისმიერ სტუმარს/მომხმარებელს (სავალდებულო ველებისა და ზომის მკაცრი შემოწმებით)
    // - წაკითხვა: სრულ ადმინისტრატორს ან ავტორიზებულ შემკვეთს საკუთარ შეკვეთაზე
    // - შეცვლა, წაშლა: მხოლოდ სრულ ადმინისტრატორს!
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['clientName', 'clientPhone'])
                    && request.resource.data.clientName is string
                    && request.resource.data.clientName.size() > 0
                    && request.resource.data.clientName.size() <= 120
                    && request.resource.data.clientPhone is string
                    && request.resource.data.clientPhone.size() >= 4
                    && request.resource.data.clientPhone.size() <= 40
                    && request.resource.data.size() <= 30;

      allow read: if isFullAdmin() || (
        request.auth != null &&
        resource.data.clientEmail != null &&
        request.auth.token.email != null &&
        resource.data.clientEmail.lower() == request.auth.token.email.lower()
      );

      allow update, delete: if isFullAdmin();
    }

    // ==========================================
    // ნივთების ნახვების სტატისტიკა (/productStats)
    // ==========================================
    // - წაკითხვა და წაშლა: მხოლოდ სრულ ადმინისტრატორს
    // - ჩაწერა (ნახვის დაფიქსირება): საჯარო (მხოლოდ views +1, uniqueViews +0/1)
    match /productStats/{productId} {
      allow read, delete: if isFullAdmin();

      allow create: if request.resource.data.keys().hasOnly(['views', 'uniqueViews', 'lastViewedAt'])
                    && request.resource.data.views == 1
                    && (request.resource.data.uniqueViews == 0 || request.resource.data.uniqueViews == 1);

      allow update: if isFullAdmin()
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'uniqueViews', 'lastViewedAt'])
                      && request.resource.data.views == resource.data.views + 1
                      && (
                        request.resource.data.uniqueViews == resource.data.uniqueViews
                        || request.resource.data.uniqueViews == resource.data.uniqueViews + 1
                      )
                    );
    }
  }
}
