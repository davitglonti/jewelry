rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // პროდუქტების კოლექცია (Products collection)
    // წაკითხვა ყველასთვის ღიაა (სტუმრებისთვისაც).
    // დამატება, რედაქტირება და წაშლა მხოლოდ ადმინისტრატორს შეუძლია (Admin Dashboard).
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // მაღაზიის პარამეტრები და სექციები (Settings & Home customization)
    match /aurelia/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ბლოგის სტატიები (Blog articles)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // შემოსული მოთხოვნები (Inquiries)
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ნივთების ნახვების სტატისტიკა (Product Stats)
    // წაკითხვა და წაშლა: მხოლოდ ადმინისტრატორს
    // ჩაწერა: ყველას, მხოლოდ views +1, uniqueViews +0 ან +1, და lastViewedAt
    match /productStats/{productId} {
      allow read, delete: if request.auth != null;

      allow create: if request.resource.data.keys().hasOnly(['views', 'uniqueViews', 'lastViewedAt'])
                    && request.resource.data.views == 1
                    && (request.resource.data.uniqueViews == 0 || request.resource.data.uniqueViews == 1);

      allow update: if request.auth != null
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'uniqueViews', 'lastViewedAt'])
                      && request.resource.data.views == resource.data.views + 1
                      && (
                        request.resource.data.uniqueViews == resource.data.uniqueViews
                        || request.resource.data.uniqueViews == resource.data.uniqueViews + 1
                      )
                    );
    }
  }
}
